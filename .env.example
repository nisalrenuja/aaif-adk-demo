# Copy to .env and fill in. The .env file is gitignored.
#
# Required for every phase. Free key from Google AI Studio:
#   https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=paste-your-key-here

# Optional, Phase 5 only. One of these, matching the model you point LiteLlm at.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional, Phase 8 cloud_run deploy only.
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
